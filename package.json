{
  "name": "psm",
  "version": "0.2.5",
  "description": "Workspace cockpit and project glue — scans every project, runs work sessions, and helps reuse capabilities before creating new projects. Runs locally, or as an agent driven by the hosted cockpit at psm.werewolf.solutions.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "agent": "PSM_MODE=agent NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/server/index.ts",
    "web": "./scripts/static.sh",
    "server": "./scripts/dev.sh",
    "scan": "tsx src/cli.ts scan",
    "build:md": "tsx src/cli.ts build",
    "list": "tsx src/cli.ts list",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.223",
    "@napi-rs/keyring": "^1.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fflate": "^0.8.2",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "typescript": "^5.4.0"
  }
}
