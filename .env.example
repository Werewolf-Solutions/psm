# psm environment reference. Copy what you need; every value here has a default
# that works for local development, so an empty environment gives you dev mode.

# ---------------------------------------------------------------------------
# Which posture this process runs in: dev | agent | hosted
#   dev      (default) local tool, scans psm.config.json's workspaceRoot
#   agent    local, scans only linked folders, pairable with the hosted UI
#   hosted   deployed, authenticated, multi-tenant, cannot run anything locally
# "production" and "prod" are accepted spellings of hosted.
# ---------------------------------------------------------------------------
PSM_MODE=dev

# Port to listen on (default 4317).
PORT=4317

# ---------------------------------------------------------------------------
# Agent mode
# ---------------------------------------------------------------------------
# Browser origins allowed to drive this agent, comma separated. Requests from
# them still need the pairing token; the origin allowlist is not authentication.
PSM_HOSTED_ORIGIN=https://psm.werewolf.solutions

# Where the pairing token is stored (0600). Defaults to ./.psm-agent.json.
# PSM_AGENT_FILE=/home/you/.config/psm/agent.json

# ---------------------------------------------------------------------------
# Hosted mode — auth
#
# psm signs people in through werewolf-dapp with "Continue with Werewolf"
# (authorization code + PKCE). psm's server is the confidential client: it holds
# the refresh token and gives the browser only an httpOnly cookie, so no key
# material is shared and no token reaches the page. There is no password path.
# ---------------------------------------------------------------------------
# REQUIRED in hosted mode: signs the session cookie. Rotating it signs everyone
# out. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PSM_SESSION_SECRET=change-me

# Which Werewolf API to talk to. Decided by the mode unless set here:
#   dev            → http://127.0.0.1:3000/api/v1   (local werewolf-dapp)
#   agent, hosted  → https://werewolf.solutions/api/v1
# WEREWOLF_API_URL=https://werewolf.solutions/api/v1
# WEREWOLF_LOCAL_API_URL=http://127.0.0.1:3000/api/v1
# WEREWOLF_PRODUCTION_API_URL=https://werewolf.solutions/api/v1

# Set to 0 to refuse dapp sign-in and require provider-signed JWTs instead.
# PSM_WEREWOLF_AUTH=1

# --- "Continue with Werewolf" (authorization code + PKCE) ---
# Where dapp's consent screen lives — its web client, not its API.
#   production   the API's own origin (https://werewolf.solutions)
#   local dapp   the running Vite dev client, discovered from the werewolf-dapp
#                project, falling back to http://localhost:5173. The API's :3000
#                serves a built bundle that is usually stale, so it is not used.
# WEREWOLF_WEB_ORIGIN=https://werewolf.solutions

# Local instances need none of this: psm is registered as a native client, so dapp
# accepts http://127.0.0.1:<any port>/api/cloud/sso/callback already.
#
# Hosted psm must be told its own public origin if it sits behind a proxy that does
# not set x-forwarded-host, and must be registered with dapp before the button
# appears at all — see docs/werewolf-psm-registration.md.
# PSM_PUBLIC_ORIGIN=https://psm.werewolf.solutions
# PSM_SSO_REGISTERED=1

# Optional additional strategies, for verifying tokens minted elsewhere.
# Verify provider-signed tokens (RS256/ES256) against its published key set:
# PSM_AUTH_JWKS_URL=https://werewolf.solutions/.well-known/jwks.json
#
# ...or verify HS256 tokens with a shared secret:
# PSM_AUTH_SECRET=change-me

# Optional but recommended once the provider is wired up:
# PSM_AUTH_ISSUER=https://werewolf.solutions
# PSM_AUTH_AUDIENCE=psm
# Cookie carrying the session (default werewolf_session). Issue it on the parent
# domain .werewolf.solutions so the sibling subdomain is signed in already.
# PSM_AUTH_COOKIE=werewolf_session

# ---------------------------------------------------------------------------
# Hosted mode — state
# ---------------------------------------------------------------------------
# Per-account state lives under $PSM_DATA_DIR/users/<account>/. Point this at a
# persistent volume; the container's own filesystem is not one.
PSM_DATA_DIR=/var/lib/psm

# Interface to bind in hosted mode (default 0.0.0.0, behind your TLS proxy).
# Local modes ignore this and always bind 127.0.0.1.
# PSM_BIND=0.0.0.0
