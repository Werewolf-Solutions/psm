# psm environment reference. Everything here has a default that works for local
# development, so an empty environment gives you the local cockpit.
#
# There is no .env on any server: psm.werewolf.solutions is static files served
# by nginx, with no psm process behind it. See docs/deploy/PUBLISHING-A-NEW-APP.md.

# ---------------------------------------------------------------------------
# Which posture this process runs in: dev | agent
#   dev     (default) the local cockpit — scans psm.config.json's workspaceRoot
#   agent   local too, but scans only linked folders and accepts a paired
#           browser origin (psm.werewolf.solutions) carrying the pairing token
# `hosted` was retired and is now refused with a pointer to the static site.
# ---------------------------------------------------------------------------
PSM_MODE=dev

# Port to listen on (default 4317). psm always binds 127.0.0.1.
PORT=4317

# ---------------------------------------------------------------------------
# Agent mode — the boundary a hosted page crosses
# ---------------------------------------------------------------------------
# Browser origins allowed to drive this agent, comma separated. Requests from
# them still need the pairing token; the origin allowlist is not authentication.
PSM_HOSTED_ORIGIN=https://psm.werewolf.solutions

# Where the pairing token is stored (0600). Defaults to ./.psm-agent.json.
# It is shell-equivalent: anything holding it can run commands here.
# PSM_AGENT_FILE=/home/you/.config/psm/agent.json

# ---------------------------------------------------------------------------
# Werewolf — accounts, sync, backups, billing
#
# The cockpit signs in with "Continue with Werewolf": authorization code + PKCE
# against werewolf-dapp, redeemed server-side, session held in memory. psm never
# handles a password.
# ---------------------------------------------------------------------------
# Which Werewolf API to talk to. Decided by the mode unless set here:
#   dev     → http://127.0.0.1:3000/api/v1   (local werewolf-dapp)
#   agent   → https://werewolf.solutions/api/v1
# WEREWOLF_API_URL=https://werewolf.solutions/api/v1
# WEREWOLF_LOCAL_API_URL=http://127.0.0.1:3000/api/v1
# WEREWOLF_PRODUCTION_API_URL=https://werewolf.solutions/api/v1

# Where dapp's consent screen lives — its web client, not its API.
#   production   the API's own origin (https://werewolf.solutions)
#   local dapp   the running Vite dev client, discovered from the werewolf-dapp
#                project, falling back to http://localhost:5173. The API's :3000
#                serves a built bundle that is usually stale, so it is not used.
# WEREWOLF_WEB_ORIGIN=https://werewolf.solutions
