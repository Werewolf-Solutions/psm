node_modules/
*.log

# Secrets. Nothing here has ever been committed, and nothing should be: psm is
# deployed as static files with no .env on the server, so a .env in this repo is
# always a local one holding real credentials.
.env
.env.*
!.env.example

# Local state psm writes beside itself.
.psm-sessions.json
.psm-plans/
.psm-notes/
.psm-logs/
.psm-attachments-state.json
.psm-catalog-cache.json
.psm-catalog.json
.psm-cloud-device.json
.psm-cloud.json
.psm-agent.json
.psm-native-cache/
.psm-links.json
.psm-data/
.psm-credentials/
.psm-deploy-logs/

# `go build` in host-helper/ drops the compiled binary beside its source.
host-helper/host-helper
.psm-prod.env
.psm-triage-cache.json
.psm-executor.json
.psm-executor-activity.json
.psm-jobs/
.psm-switches.json
.psm-review-causes.json

# Stamped by the deploy workflow so the page can spot an out-of-date agent.
web/version.json

notes.md

# Generated Python bytecode.
__pycache__/
*.pyc
.psm-workspaces.json

# psm operator token for the local cockpit (local-operator-authority.md).
.psm-operator.json
